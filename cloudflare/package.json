{
  "name": "evtl-leis-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:esquema": "wrangler d1 execute evtl-leis --remote --file=schema.sql",
    "d1:dados": "wrangler d1 execute evtl-leis --remote --file=d1_dados.sql",
    "d1:local": "wrangler d1 execute evtl-leis --local --file=schema.sql && wrangler d1 execute evtl-leis --local --file=d1_dados.sql"
  },
  "devDependencies": { "wrangler": "4.161.0" }
}
